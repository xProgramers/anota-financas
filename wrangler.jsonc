{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anota-financas",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-13",
  // nodejs_compat: o supabase-js e o process.env (preenchido com as variáveis e secrets do Worker)
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // Builds de branches/PRs na Cloudflare usam `wrangler preview`, que exige este bloco (pode ser vazio)
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router: qualquer rota que não seja arquivo devolve o index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
