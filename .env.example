# ---------- Públicas (vão para o navegador; seguras com RLS) ----------
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# ---------- Somente servidor (Vercel Functions em /api) ----------
# Mesmos valores do Supabase acima (o servidor também aceita as VITE_*, mas prefira estas)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Chave gratuita do Google AI Studio: https://aistudio.google.com → Get API key
# Sem ela o app usa o interpretador local (regras), que cobre os casos comuns.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-2.5-flash  (ex.: gemini-2.5-flash-lite para limites maiores)
GEMINI_MODEL=
